# PROJECT VRITRA — Backend Environment Configuration

# Server Port (default: 5433 for local dev)
PORT=5433

# Allowed Frontend Origin for CORS (e.g., https://your-frontend.vercel.app)
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (obtain from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# JWT Authentication Secret (obtain from Supabase Dashboard > Project Settings > API > JWT Secret)
JWT_SECRET=your-supabase-jwt-secret
